        int max = slidingWindow(arr, 3);

        System.out.println(
            "Maximum sum of size 3 = " + max
        );


        // -----------------------------------------------------
        // PREFIX SUM
        // -----------------------------------------------------

        System.out.println("\n3. PREFIX SUM");

        int[] prefix = prefixSum(arr);

        System.out.println(
            "Prefix Array = " + Arrays.toString(prefix)
        );


        // Range sum from index 1 to 4

        int l = 1;
        int r = 4;

        int rangeSum =
                prefix[r + 1] - prefix[l];

        System.out.println(
            "Range Sum = " + rangeSum
        );


        // -----------------------------------------------------
        // BINARY SEARCH
        // -----------------------------------------------------

        System.out.println("\n4. BINARY SEARCH");

        int target = 4;

        int index =
                binarySearch(arr, target);

        System.out.println(
            "Index of " + target + " = " + index
        );


        // -----------------------------------------------------
        // HASHMAP
        // -----------------------------------------------------

        System.out.println("\n5. HASHMAP");

        int[] nums = {
            1, 2, 2, 3, 3, 3, 4
        };

        frequency(nums);


        // -----------------------------------------------------
        // MONOTONIC STACK
        // -----------------------------------------------------

        System.out.println("\n6. MONOTONIC STACK");

        int[] nge = {
            4, 5, 2, 10, 8
        };

        nextGreaterElement(nge);


        // -----------------------------------------------------
        // GRAPH
        // -----------------------------------------------------

        System.out.println("\n7. DFS / BFS");

        int n = 5;

        ArrayList<Integer>[] graph =
                new ArrayList[n];

        for (int i = 0; i < n; i++) {
            graph[i] = new ArrayList<>();
        }


        // Edges

        graph[0].add(1);
        graph[1].add(0);

        graph[0].add(2);
        graph[2].add(0);

        graph[1].add(3);
        graph[3].add(1);

        graph[2].add(4);
        graph[4].add(2);


        System.out.print("DFS: ");

        boolean[] visited =
                new boolean[n];

        dfs(0, graph, visited);

        System.out.println();


        System.out.print("BFS: ");

        bfs(0, graph);


        // -----------------------------------------------------
        // PRIORITY QUEUE
        // -----------------------------------------------------

        System.out.println("\n8. PRIORITY QUEUE");

        priorityQueueExample();


        // -----------------------------------------------------
        // BACKTRACKING
        // -----------------------------------------------------

        System.out.println("\n9. BACKTRACKING");

        int[] subsetArray = {
            1, 2, 3
        };

        subsets(
            0,
            subsetArray,
            new ArrayList<>()
        );


        // -----------------------------------------------------
        // DYNAMIC PROGRAMMING
        // -----------------------------------------------------

        System.out.println("\n10. DYNAMIC PROGRAMMING");

        int number = 10;

        System.out.println(
            "Fibonacci(" + number + ") = "
            + fibonacci(number)
        );


        // -----------------------------------------------------
        // DSU
        // -----------------------------------------------------

        System.out.println("\n11. UNION FIND / DSU");

        DSU dsu = new DSU(5);

        dsu.union(0, 1);
        dsu.union(1, 2);

        System.out.println(
            "Are 0 and 2 connected? "
            + (dsu.find(0) == dsu.find(2))
        );

        System.out.println(
            "Are 0 and 4 connected? "
            + (dsu.find(0) == dsu.find(4))
        );


        sc.close();
    }
}

