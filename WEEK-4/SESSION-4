import java.io.BufferedReader;
import java.io.BufferedWriter;
import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Paths;
import java.util.ArrayList;
import java.util.HashSet;
import java.util.List;
import java.util.Set;

public class JavaEfficiencyExamples {

    public static void main(String[] args) {
        System.out.println("=== 1. String Concatenation ===");
        runStringConcatenationExample();

        System.out.println("\n=== 2. Pre-sizing Collections & Fast Lookups ===");
        runCollectionOptimizationExample();

        System.out.println("\n=== 3. Avoiding Autoboxing Overhead ===");
        runPrimitiveVsWrapperExample();

        System.out.println("\n=== 4. Hotspot Loop Optimization ===");
        runLoopOptimizationExample();

        System.out.println("\n=== 5. Buffered File I/O ===");
        runBufferedIOExample();
    }

    /**
     * 1. STRING CONCATENATION
     * Use StringBuilder with pre-allocated capacity instead of '+' in loops
     * to avoid creating thousands of short-lived temporary String objects.
     */
    private static void runStringConcatenationExample() {
        int iterations = 10_000;

        // ✅ Efficient Approach
        long startTime = System.nanoTime();
        StringBuilder sb = new StringBuilder(iterations * 5); // Pre-allocate buffer
        for (int i = 0; i < iterations; i++) {
            sb.append(i);
        }
        String result = sb.toString();
        long duration = System.nanoTime() - startTime;

        System.out.println("StringBuilder time: " + (duration / 1_000_000.0) + " ms");
        System.out.println("Result length: " + result.length());
    }

    /**
     * 2. PRE-SIZING COLLECTIONS & FAST LOOKUPS
     * Pre-size ArrayLists to prevent dynamic array copying.
     * Use HashSet for O(1) membership checks instead of O(N) List lookups.
     */
    private static void runCollectionOptimizationExample() {
        int size = 1_000_000;

        // ✅ Efficient Pre-sized List
        List<Integer> numbers = new ArrayList<>(size);
        for (int i = 0; i < size; i++) {
            numbers.add(i);
        }

        // ✅ Efficient O(1) Lookup with HashSet
        Set<Integer> numberSet = new HashSet<>(numbers);

        long startTime = System.nanoTime();
        boolean exists = numberSet.contains(999_999); // O(1) time
        long duration = System.nanoTime() - startTime;

        System.out.println("HashSet O(1) lookup time: " + duration + " ns (found: " + exists + ")");
    }

    /**
     * 3. PRIMITIVES VS. WRAPPER TYPES (AUTOBOXING)
     * Use primitive types ('long', 'int') in tight loops to prevent heap allocation
     * and automatic boxing/unboxing overhead.
     */
    private static void runPrimitiveVsWrapperExample() {
        int iterations = 10_000_000;

        // ✅ Efficient Primitive Usage
        long startTime = System.nanoTime();
        long sum = 0L;
        for (long i = 0; i < iterations; i++) {
            sum += i; // No object allocation or unboxing
        }
        long duration = System.nanoTime() - startTime;

        System.out.println("Primitive calculation time: " + (duration / 1_000_000.0) + " ms (Sum: " + sum + ")");
    }

    /**
     * 4. HOTSPOT LOOP OPTIMIZATION
     * Use traditional indexed loops and bitwise operations in core hotspots
     * to eliminate functional stream call stack overhead and maximize JIT optimization.
     */
    private static void runLoopOptimizationExample() {
        int size = 1_000_000;
        List<Integer> list = new ArrayList<>(size);
        for (int i = 0; i < size; i++) {
            list.add(i);
        }

        long startTime = System.nanoTime();
        List<Integer> processedEvens = new ArrayList<>(size / 2);

        // Standard indexed loop using bitwise operations
        for (int i = 0; i < list.size(); i++) {
            int val = list.get(i);
            if ((val & 1) == 0) {    // Bitwise check for even (val % 2 == 0)
                processedEvens.add(val << 1); // Bitwise shift for multiplication by 2 (val * 2)
            }
        }
        long duration = System.nanoTime() - startTime;

        System.out.println("Optimized loop execution time: " + (duration / 1_000_000.0) + " ms");
    }

    /**
     * 5. EFFICIENT FILE I/O
     * Use BufferedReader / BufferedWriter with try-with-resources to minimize disk accesses
     * and automatically close resources without memory leaks.
     */
    private static void runBufferedIOExample() {
        String filename = "temp_performance_test.txt";

        // Write sample data efficiently using BufferedWriter
        try (BufferedWriter writer = Files.newBufferedWriter(Paths.get(filename))) {
            for (int i = 0; i < 1000; i++) {
                writer.write("Sample performance log line #" + i);
                writer.newLine();
            }
        } catch (IOException e) {
            e.printStackTrace();
        }

        // Read sample data efficiently using BufferedReader
        int lineCount = 0;
        try (BufferedReader reader = Files.newBufferedReader(Paths.get(filename))) {
            while (reader.readLine() != null) {
                lineCount++;
            }
        } catch (IOException e) {
            e.printStackTrace();
        } finally {
            // Cleanup sample file
            try {
                Files.deleteIfExists(Paths.get(filename));
            } catch (IOException ignored) {}
        }

        System.out.println("Successfully processed " + lineCount + " lines via buffered I/O.");
    }
}

